{
  "name": "@dsqr/pi-extension-checks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test continue-after-compaction/test/*.test.ts cloak/test/*.test.ts save-md/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  }
}
