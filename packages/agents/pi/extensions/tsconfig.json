{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "vendor.d.ts",
    "continue-after-compaction/**/*.ts",
    "cloak/**/*.ts",
    "save-md/**/*.ts"
  ]
}
