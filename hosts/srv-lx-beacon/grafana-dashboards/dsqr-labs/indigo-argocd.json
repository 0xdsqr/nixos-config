  "panels": [
    {
      "id": 1,
      "title": "Scope and interpretation",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "OutOfSync is desired-state drift, not proof of a failed sync; manual approvals may leave it intentionally pending. Application inventory is deduplicated by namespace/name. Sync counters only exist for observed operations; an empty phase is not a guaranteed zero. These panels do not configure alerts or Discord delivery."
      }
    },
    {
      "id": 2,
      "title": "Applications observed",
      "description": "",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by(namespace,name)(argocd_app_info{cluster=\"indigo\"}))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ]
    },
