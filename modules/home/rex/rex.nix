{ inputs, ... }: {
  flake.homeModules.rex =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      inherit (lib.attrsets) attrValues filterAttrs;
      inherit (lib.generators) toLua;
      inherit (lib.lists) all head length;
      inherit (lib.modules) mkIf;
      inherit (lib.options) mkEnableOption mkOption;
      inherit (lib.strings) concatMapStringsSep concatStringsSep optionalString;
      inherit (lib.types)
        anything
        attrsOf
        lines
        listOf
        nullOr
        package
        port
        str
        submodule
        ;

      cfg = config.dsqr.home.rex;

      lua = toLua { };

      # A host is reached either at explicit endpoints or at its MagicDNS name
      # on this machine's tailnet. The tailnet is per machine, so the same host
      # definition never leaks an address from another tailnet.
      hostEndpoints =
        host:
        if host.endpoints != [ ] then
          host.endpoints
        else
          [ "https://${host.hostName}.${cfg.tailnet}${optionalString (host.port != null) ":${toString host.port}"}" ];

      hostResolvable = host: host.endpoints != [ ] || (host.hostName != null && cfg.tailnet != null);

      renderHost =
        host:
        let
          endpoints = hostEndpoints host;
        in
        "rex.host ${
          lua (
            {
              inherit (host) label;
            }
            // (if length endpoints == 1 then { endpoint = head endpoints; } else { inherit endpoints; })
            // filterAttrs (_: value: value != null) { inherit (host) id icon; }
          )
        }";

      renderBind =
        bind: "rex.bind(${lua bind.key}, ${lua bind.action}${optionalString (bind.args != { }) ", ${lua bind.args}"})";

      hosts = attrValues cfg.hosts;

      initLua = concatStringsSep "\n" (
        [ "-- Generated by Nix from dsqr.home.rex. Edits here are overwritten." ]
        ++ lib.optional (hosts != [ ]) (concatMapStringsSep "\n\n" renderHost hosts)
        ++ lib.optional (cfg.binds != [ ]) (concatMapStringsSep "\n" renderBind cfg.binds)
        ++ lib.optional (cfg.extraConfig != "") cfg.extraConfig
      );

      hasConfig = hosts != [ ] || cfg.binds != [ ] || cfg.extraConfig != "";

      # `rex config check` needs no running server, so a mistake fails the build
      # instead of the next `rex config reload`.
      checkedInitLua =
        pkgs.runCommand "rex-init.lua"
          {
            text = initLua + "\n";
            passAsFile = [ "text" ];
          }
          ''
            export HOME="$TMPDIR" REX_AUTOSTART=0
            cp "$textPath" init.lua
            ${cfg.package}/bin/rex config check "$PWD/init.lua"
            cp init.lua "$out"
          '';
    in
    {
      imports = [ inputs.rex.homeManagerModules.default ];

      options.dsqr.home.rex = {
        enable = mkEnableOption "Rex CLI tooling and configuration";

        package = mkOption {
          type = package;
          default = inputs.rex.packages.${pkgs.stdenv.hostPlatform.system}.rex;
          defaultText = lib.literalExpression "inputs.rex.packages.${pkgs.stdenv.hostPlatform.system}.rex";
          description = "Rex package to install.";
        };

        tailnet = mkOption {
          type = nullOr str;
          default = null;
          example = "tail1234.ts.net";
          description = ''
            MagicDNS suffix of the tailnet this machine's Rex is signed in to.
            Hosts declared with `hostName` resolve against it, so each machine
            only ever links to servers on its own tailnet.
          '';
        };

        hosts = mkOption {
          default = { };
          description = "Other Rex servers this machine connects to, written as `rex.host` entries.";
          example = lib.literalExpression ''
            {
              khaos = {
                label = "Khaos";
                hostName = "srv-lx-khaos";
                port = 7297;
              };
            }
          '';
          type = attrsOf (
            submodule (
              { name, ... }: {
                options = {
                  label = mkOption {
                    type = str;
                    default = name;
                    description = "Name shown for the host in Rex.";
                  };

                  hostName = mkOption {
                    type = nullOr str;
                    default = null;
                    description = "Machine name on `dsqr.home.rex.tailnet`. Served over HTTPS.";
                  };

                  port = mkOption {
                    type = nullOr port;
                    default = null;
                    description = "HTTPS port for `hostName`. Null uses Rex's default lookup.";
                  };

                  endpoints = mkOption {
                    type = listOf str;
                    default = [ ];
                    example = [ "ssh://alice@build.example.com" ];
                    description = "Explicit addresses, tried in order. Overrides `hostName` and `port`.";
                  };

                  id = mkOption {
                    type = nullOr str;
                    default = null;
                    description = "Stable ID, so the host keeps its identity when renamed.";
                  };

                  icon = mkOption {
                    type = nullOr str;
                    default = null;
                    description = "Icon name for clients to show.";
                  };
                };
              }
            )
          );
        };

        binds = mkOption {
          default = [ ];
          description = "Key bindings, written as `rex.bind` calls in order.";
          example = lib.literalExpression ''
            [
              {
                key = "cmd+d";
                action = "pane.split";
                args.direction = "right";
              }
            ]
          '';
          type = listOf (submodule {
            options = {
              key = mkOption {
                type = str;
                description = "Key or key sequence, such as `cmd+d` or `ctrl+b>c`.";
              };

              action = mkOption {
                type = str;
                description = "Action to run.";
              };

              args = mkOption {
                type = attrsOf anything;
                default = { };
                description = "Arguments passed to the action.";
              };
            };
          });
        };

        extraConfig = mkOption {
          type = lines;
          default = "";
          description = "Lua appended to the generated `rex/init.lua`, for modes, actions, and anything else.";
        };

        sshGuard = mkEnableOption "the Rex SSH terminal compatibility guard" // {
          default = true;
        };
      };

      config = mkIf cfg.enable {
        assertions = [
          {
            assertion = !cfg.sshGuard || config.dsqr.home.ssh.enable;
            message = "dsqr.home.rex.sshGuard requires dsqr.home.ssh.enable = true.";
          }
          {
            assertion = all hostResolvable hosts;
            message = "Each dsqr.home.rex.hosts entry needs `endpoints`, or `hostName` together with dsqr.home.rex.tailnet.";
          }
        ];

        programs.rex = {
          enable = true;
          inherit (cfg) package;

          # modules/home/ssh.nix owns ~/.ssh/config, so include the guard there
          # instead of enabling home-manager's programs.ssh module.
          sshGuard = false;

          config = mkIf hasConfig checkedInitLua;
        };

        dsqr.home.ssh.includes = mkIf cfg.sshGuard [ "${cfg.package}/share/rex/ssh_config.d/50-rex.conf" ];
      };
    };
}
